{
  "name": "juris-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Read-only MCP server over the Juris Web API, for Claude Desktop and other MCP clients",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "mock": "tsx mock/start.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:auth": "tsx scripts/auth-check.ts",
    "pack": "tsx scripts/pack.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/express": "4.17.21",
    "@types/node": "22.20.5",
    "express": "4.21.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
